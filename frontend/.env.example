# Local development environment (copy to .env for `vite dev`).
#
# The deployed app is same-origin: dev/prod builds leave VITE_APPSYNC_ENDPOINT
# and VITE_COGNITO_DOMAIN unset and serve /graphql plus auth (/login, /logout,
# /oauth2/*) through the site's CloudFront distribution. Local `vite dev` and
# ephemeral environments have no distribution, so they set absolute values
# here (or via scripts/ephemeral-env.sh).

# AppSync GraphQL API — direct endpoint (tofu output appsync_api_url), required
# for `vite dev`. The api.dev.kernelworx.app CNAME is removed; use the direct
# appsync-api hostname.
VITE_APPSYNC_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
VITE_APPSYNC_REGION=us-east-1

# Cognito User Pool
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# Direct Cognito custom domain — required for `vite dev`
VITE_COGNITO_DOMAIN=login.dev.kernelworx.app

# OAuth Configuration
# For localhost development:
VITE_OAUTH_REDIRECT_SIGNIN=http://localhost:5173/
VITE_OAUTH_REDIRECT_SIGNOUT=http://localhost:5173/

# For local.dev.appworx.app development (requires SSL):
# VITE_OAUTH_REDIRECT_SIGNIN=https://local.dev.appworx.app:5173
# VITE_OAUTH_REDIRECT_SIGNOUT=https://local.dev.appworx.app:5173
