#if($ctx.error)
    $util.error($ctx.error.message, $ctx.error.type)
#end
#if(!$ctx.result || $ctx.result.isEmpty())
    $util.toJson(null)
#else
    ## #509: a catalog is readable by ID only when it is public, admin-managed,
    ## or owned by the caller. Note: ownerAccountId is removed from the GraphQL
    ## schema but still present in DynamoDB for this authorization check.
    #set($callerAccountId = "ACCOUNT#$ctx.identity.sub")
    #if($ctx.result.isPublic == true || $ctx.result.catalogType == "ADMIN_MANAGED" || $ctx.result.ownerAccountId == $callerAccountId)
        $util.toJson($ctx.result)
    #else
        $util.toJson(null)
    #end
#end