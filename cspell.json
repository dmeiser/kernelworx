{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "name": "KernelWorx",
  "description": "KernelWorx project dictionary",
  "dictionaryDefinitions": [
    {
      "name": "kernelworx-words",
      "path": ".cspell/kernelworx-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["kernelworx-words"],
  "flagWords": ["Kernelworx"],
  "_comment": "Kernelworx (mixed case) is deprecated and flagged; kernelworx (lowercase) is the AWS resource-name token; KernelWorx (PascalCase) is the brand name",
  "ignorePaths": [
    "cspell.json",
    "**/node_modules/**",
    "frontend/dist/**",
    "tofu/application/appsync/dist/**",
    "frontend/coverage/**",
    "frontend/playwright-report/**",
    "frontend/test-results/**",
    "frontend/.cert/**",
    ".venv/**",
    ".git/**",
    ".build/**",
    "**/__pycache__/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "htmlcov/**",
    "package-lock.json",
    "frontend/package-lock.json",
    "uv.lock",
    ".env",
    ".env.*",
    "frontend/.env",
    "frontend/.env.*",
    "tofu/**/.terraform/**",
    "tofu/**/terraform.tfstate*",
    "tofu/kics-results/**",
    "coverage/**",
    "docs/branding/system/**",
    "docs/branding/**/*.html",
    "docs/branding/assets/**",
    "claude-fable-review.md",
    "kimi-not-handling.md",
    "tests/e2e/fixtures/*.ics"
  ],
  "_comment_ics_captures": "tests/e2e/fixtures/*.ics are captures of buildInvite's bytes. RFC 5545 folds a property line at a fixed octet budget, which splits words at the seam by design, so spellchecking a physical line of a capture flags fold artifacts rather than typos; the content of those files is checked by the Stage 3 lane's ICS validator in tests/e2e/utils/show_sell_stage3_support.py.",
  "ignoreRegExpList": [
    "https?://[^\\s]+",
    "[a-f0-9]{32,}",
    "CATALOG#[A-Za-z0-9-]+",
    "PROFILE#[A-Za-z0-9-]+",
    "CAMPAIGN#[A-Za-z0-9-]+",
    "ACCOUNT#[A-Za-z0-9-]+",
    "PROD#[A-Za-z0-9-]+",
    "UNIT#[A-Za-z0-9-]+",
    "UNITCAMP#[A-Za-z0-9-]+",
    "\\bJOIN[A-Z0-9]{12}\\b",
    "CAT~[A-Za-z0-9-]+",
    "SHARED-[A-Za-z0-9]+",
    "[A-Za-z0-9_-]+@[A-Za-z0-9.-]+",
    "\\bZ[0-9A-Z]{10,}\\b",
    "\\b[a-z0-9]{26}\\b",
    "\\\\u[0-9a-fA-F]{4}",
    "arn:aws:iam::[0-9]+:role/\\S+"
  ]
}
